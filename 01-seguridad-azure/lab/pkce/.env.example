# Configuración de la API local
PORT=4010
NODE_ENV=development

# Azure AD / Entra ID
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_API_CLIENT_ID=<api-client-id>
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
AZURE_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AZURE_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
API_AUDIENCE=api://<api-client-id>
ALLOWED_SCOPES=access_as_user
VALID_ISSUERS=https://login.microsoftonline.com/<tenant-id>/v2.0

# PKCE / pruebas
REDIRECT_URI=http://localhost/callback
REQUESTED_SCOPE=api://<api-client-id>/access_as_user
CLIENT_ID=<client-id>

# Valores temporales que se rellenan durante el runbook
PKCE_CODE_VERIFIER=
PKCE_CODE_CHALLENGE=
AUTHORIZATION_CODE=
ACCESS_TOKEN=
